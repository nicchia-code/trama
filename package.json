  },
  "dependencies": {
    "cytoscape": "^3.34.3",
    "elkjs": "^0.12.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/cytoscape": "^3.31.0",
    "@types/vscode": "^1.138.0",
    "typescript": "^7.0.2"
  }
}
