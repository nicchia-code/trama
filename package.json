{
  "name": "trama",
  "version": "0.3.12",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "build": "bun build --compile src/cli/bin.ts --outfile dist/trama",
