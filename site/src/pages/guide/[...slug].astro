---
import { getCollection, render } from "astro:content";
import manifest from "../../../../extension/package.json";
import SettingsList from "../../components/SettingsList.astro";
import GuideLayout from "../../layouts/GuideLayout.astro";
import { buildGuideNav } from "../../lib/guide";
import { describeSettings, settingHeadings } from "../../lib/settings";

export async function getStaticPaths() {
  const pages = await getCollection("guide");
  return pages.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const pages = await getCollection("guide");
const nav = buildGuideNav(pages.map((p) => ({ id: p.id, title: p.data.title, order: p.data.order })));
const { Content, headings } = await render(entry);
const showSettings = entry.data.generated === "settings";
// The settings page ends with the list of every setting; its groups and settings are in the page's table of contents too.
const allHeadings = showSettings ? [...headings, ...settingHeadings(describeSettings(manifest))] : headings;
---

<GuideLayout title={entry.data.title} description={entry.data.description} nav={nav} currentId={entry.id} headings={allHeadings}>
  <Content />
  {showSettings && <SettingsList />}
</GuideLayout>
